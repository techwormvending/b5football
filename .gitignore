# Dependencies
node_modules/

# Secrets: never commit these (the repo is public). Use Actions secrets / backend env vars.
.env
.env.*
!.env.example

# League and lineup data (saved lineups, PIN hashes, scores, audit log)
data/

# Caches and local test data
.cache/
.bakeoff/
*.tmp

# Local editor/agent settings
.claude/settings.local.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Edge Function build copy of src/ (made by the deploy workflow)
supabase/functions/b5-live/_src/
supabase/functions/notify/_src/

# Spreadsheets (e.g. the payout sheet) never go in this public repo
*.xlsx
*.xls
*.csv
!src/**/*.csv
