{
  "external_email_enabled": true,
  "mailer_otp_exp": 600,
  "mailer_otp_length": 6,
  "password_min_length": 8,
  "security_update_password_require_reauthentication": true,
  "rate_limit_verify": 30,
  "rate_limit_token_refresh": 150,
  "mailer_subjects_magic_link": "Your B5 sign-in code: {{ .Token }}",
  "mailer_templates_magic_link_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#f4f4f1;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a\">\n  <div style=\"max-width:520px;margin:0 auto;padding:24px 16px\">\n    <div style=\"background:#0b0b0b;border-radius:10px 10px 0 0;padding:16px 20px;border-bottom:4px solid #ffb612\">\n      <span style=\"display:inline-block;background:#ffb612;color:#0b0b0b;font:bold 22px Arial,Helvetica,sans-serif;padding:4px 10px;border-radius:4px\">B5</span>\n      <span style=\"color:#f5f5f2;font:bold 16px Arial,Helvetica,sans-serif;margin-left:8px\">Bridgeville 5 Fantasy Site</span>\n    </div>\n    <div style=\"background:#ffffff;border-radius:0 0 10px 10px;padding:24px 20px\">\n      <h1 style=\"font-size:24px;margin:0 0 12px\">Your sign-in code</h1>\n      <p style=\"font-size:18px;line-height:1.5;margin:0 0 16px\">Here is your code to sign in to the B5 site:</p>\n      <div style=\"font:bold 40px/1.2 'Courier New',Courier,monospace;letter-spacing:10px;text-align:center;background:#fff7e0;border:2px solid #ffb612;border-radius:10px;padding:16px 8px;margin:0 0 16px\">{{ .Token }}</div>\n      <p style=\"font-size:17px;line-height:1.5;margin:0 0 12px\">Type it on the sign-in page (the page where you asked for it).</p>\n      <p style=\"font-size:15px;line-height:1.5;color:#555;margin:0\">The code works once and expires in 10 minutes. If you didn't ask for it, you can ignore this email: nobody can sign in without it.</p>\n    </div>\n    <p style=\"font-size:14px;color:#777;text-align:center;margin:12px 0 0\">b5football.win · Sent to {{ .Email }}</p>\n  </div>\n</body></html>\n",
  "mailer_subjects_confirmation": "Welcome to B5: your sign-in code {{ .Token }}",
  "mailer_templates_confirmation_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#f4f4f1;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a\">\n  <div style=\"max-width:520px;margin:0 auto;padding:24px 16px\">\n    <div style=\"background:#0b0b0b;border-radius:10px 10px 0 0;padding:16px 20px;border-bottom:4px solid #ffb612\">\n      <span style=\"display:inline-block;background:#ffb612;color:#0b0b0b;font:bold 22px Arial,Helvetica,sans-serif;padding:4px 10px;border-radius:4px\">B5</span>\n      <span style=\"color:#f5f5f2;font:bold 16px Arial,Helvetica,sans-serif;margin-left:8px\">Bridgeville 5 Fantasy Site</span>\n    </div>\n    <div style=\"background:#ffffff;border-radius:0 0 10px 10px;padding:24px 20px\">\n      <h1 style=\"font-size:24px;margin:0 0 12px\">Welcome to the B5 site</h1>\n      <p style=\"font-size:18px;line-height:1.5;margin:0 0 16px\">You're invited to the Bridgeville 5. Here is your code to sign in for the first time:</p>\n      <div style=\"font:bold 40px/1.2 'Courier New',Courier,monospace;letter-spacing:10px;text-align:center;background:#fff7e0;border:2px solid #ffb612;border-radius:10px;padding:16px 8px;margin:0 0 16px\">{{ .Token }}</div>\n      <p style=\"font-size:17px;line-height:1.5;margin:0 0 12px\">Type it on the sign-in page. Then you'll be asked to create a password, so next time you can sign in without waiting for an email.</p>\n      <p style=\"font-size:15px;line-height:1.5;color:#555;margin:0\">The code works once and expires in 10 minutes. If you didn't ask for it, you can ignore this email: nobody can sign in without it.</p>\n    </div>\n    <p style=\"font-size:14px;color:#777;text-align:center;margin:12px 0 0\">b5football.win · Sent to {{ .Email }}</p>\n  </div>\n</body></html>\n",
  "mailer_subjects_invite": "Welcome to B5: your sign-in code {{ .Token }}",
  "mailer_templates_invite_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#f4f4f1;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a\">\n  <div style=\"max-width:520px;margin:0 auto;padding:24px 16px\">\n    <div style=\"background:#0b0b0b;border-radius:10px 10px 0 0;padding:16px 20px;border-bottom:4px solid #ffb612\">\n      <span style=\"display:inline-block;background:#ffb612;color:#0b0b0b;font:bold 22px Arial,Helvetica,sans-serif;padding:4px 10px;border-radius:4px\">B5</span>\n      <span style=\"color:#f5f5f2;font:bold 16px Arial,Helvetica,sans-serif;margin-left:8px\">Bridgeville 5 Fantasy Site</span>\n    </div>\n    <div style=\"background:#ffffff;border-radius:0 0 10px 10px;padding:24px 20px\">\n      <h1 style=\"font-size:24px;margin:0 0 12px\">Welcome to the B5 site</h1>\n      <p style=\"font-size:18px;line-height:1.5;margin:0 0 16px\">You're invited to the Bridgeville 5. Here is your code to sign in for the first time:</p>\n      <div style=\"font:bold 40px/1.2 'Courier New',Courier,monospace;letter-spacing:10px;text-align:center;background:#fff7e0;border:2px solid #ffb612;border-radius:10px;padding:16px 8px;margin:0 0 16px\">{{ .Token }}</div>\n      <p style=\"font-size:17px;line-height:1.5;margin:0 0 12px\">Go to b5football.win, tap Sign in, choose \"Email me a sign-in code\" if it asks, and type this code. Then create a password.</p>\n      <p style=\"font-size:15px;line-height:1.5;color:#555;margin:0\">The code works once and expires in 10 minutes. If you didn't ask for it, you can ignore this email: nobody can sign in without it.</p>\n    </div>\n    <p style=\"font-size:14px;color:#777;text-align:center;margin:12px 0 0\">b5football.win · Sent to {{ .Email }}</p>\n  </div>\n</body></html>\n",
  "mailer_subjects_recovery": "Your B5 password reset code: {{ .Token }}",
  "mailer_templates_recovery_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#f4f4f1;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a\">\n  <div style=\"max-width:520px;margin:0 auto;padding:24px 16px\">\n    <div style=\"background:#0b0b0b;border-radius:10px 10px 0 0;padding:16px 20px;border-bottom:4px solid #ffb612\">\n      <span style=\"display:inline-block;background:#ffb612;color:#0b0b0b;font:bold 22px Arial,Helvetica,sans-serif;padding:4px 10px;border-radius:4px\">B5</span>\n      <span style=\"color:#f5f5f2;font:bold 16px Arial,Helvetica,sans-serif;margin-left:8px\">Bridgeville 5 Fantasy Site</span>\n    </div>\n    <div style=\"background:#ffffff;border-radius:0 0 10px 10px;padding:24px 20px\">\n      <h1 style=\"font-size:24px;margin:0 0 12px\">Reset your password</h1>\n      <p style=\"font-size:18px;line-height:1.5;margin:0 0 16px\">Here is your code to set a new B5 password:</p>\n      <div style=\"font:bold 40px/1.2 'Courier New',Courier,monospace;letter-spacing:10px;text-align:center;background:#fff7e0;border:2px solid #ffb612;border-radius:10px;padding:16px 8px;margin:0 0 16px\">{{ .Token }}</div>\n      <p style=\"font-size:17px;line-height:1.5;margin:0 0 12px\">Type it on the \"Forgot password?\" page, along with your new password.</p>\n      <p style=\"font-size:15px;line-height:1.5;color:#555;margin:0\">The code works once and expires in 10 minutes. If you didn't ask for it, you can ignore this email: nobody can sign in without it.</p>\n    </div>\n    <p style=\"font-size:14px;color:#777;text-align:center;margin:12px 0 0\">b5football.win · Sent to {{ .Email }}</p>\n  </div>\n</body></html>\n",
  "mailer_subjects_reauthentication": "Your B5 confirmation code: {{ .Token }}",
  "mailer_templates_reauthentication_content": "<!doctype html>\n<html><body style=\"margin:0;padding:0;background:#f4f4f1;font-family:Arial,Helvetica,sans-serif;color:#1a1a1a\">\n  <div style=\"max-width:520px;margin:0 auto;padding:24px 16px\">\n    <div style=\"background:#0b0b0b;border-radius:10px 10px 0 0;padding:16px 20px;border-bottom:4px solid #ffb612\">\n      <span style=\"display:inline-block;background:#ffb612;color:#0b0b0b;font:bold 22px Arial,Helvetica,sans-serif;padding:4px 10px;border-radius:4px\">B5</span>\n      <span style=\"color:#f5f5f2;font:bold 16px Arial,Helvetica,sans-serif;margin-left:8px\">Bridgeville 5 Fantasy Site</span>\n    </div>\n    <div style=\"background:#ffffff;border-radius:0 0 10px 10px;padding:24px 20px\">\n      <h1 style=\"font-size:24px;margin:0 0 12px\">Confirm your password change</h1>\n      <p style=\"font-size:18px;line-height:1.5;margin:0 0 16px\">Here is your code to confirm the password change on your B5 account:</p>\n      <div style=\"font:bold 40px/1.2 'Courier New',Courier,monospace;letter-spacing:10px;text-align:center;background:#fff7e0;border:2px solid #ffb612;border-radius:10px;padding:16px 8px;margin:0 0 16px\">{{ .Token }}</div>\n      <p style=\"font-size:17px;line-height:1.5;margin:0 0 12px\">Type it on your Account page, where you were changing your password.</p>\n      <p style=\"font-size:15px;line-height:1.5;color:#555;margin:0\">The code works once and expires in 10 minutes. If you didn't ask for it, you can ignore this email: nobody can sign in without it.</p>\n    </div>\n    <p style=\"font-size:14px;color:#777;text-align:center;margin:12px 0 0\">b5football.win · Sent to {{ .Email }}</p>\n  </div>\n</body></html>\n"
}
